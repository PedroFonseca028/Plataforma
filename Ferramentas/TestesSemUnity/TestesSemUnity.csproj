<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Roda os testes das regras do jogo (Assets/Scripts/Logica) sem abrir o Unity.
    Uso, na raiz do projeto:  dotnet test Ferramentas/TestesSemUnity
    Os mesmos testes também aparecem no Unity em Window > General > Test Runner (EditMode).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>RumoAoHexa.Testes</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Logica/**/*.cs" />
    <Compile Include="../../Assets/Tests/EditMode/Logica/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
